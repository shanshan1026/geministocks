{
  "name": "geministocks",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "331026.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/ollama-api/*",
      "/exa-api/*",
      "/anysearch-api/*"
    ]
  }
}
